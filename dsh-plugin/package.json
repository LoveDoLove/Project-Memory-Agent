{
  "name": "@lovedolove/dsh-project-memory",
  "description": "DSH bundle plugin: mounts Project Memory skills, bootstraps memory architecture on first use, registers the /project-memory slash command, and prompts for memory compounding after tasks.",
  "version": "0.4.25",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./dsh": "./dsh/plugin.mjs"
  },
  "files": [
    "lib/index.js",
    "dsh/plugin.mjs",
    "dsh/codebase-memory-bridge.mjs",
    "dsh/slash-project-memory.mjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoveDoLove/Project-Memory-Agent.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0"
  }
}
