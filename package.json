{
  "name": "@lovedolove/dsh-project-memory",
  "description": "DSH bundle plugin: mounts Project Memory skills, bootstraps memory architecture on first use, registers the /project-memory slash command, and prompts for memory compounding after tasks.",
  "version": "0.5.3",
  "type": "module",
  "main": "dsh/plugin.mjs",
  "bin": {
    "ema": "./bin/ema-cli.mjs",
    "ema-mcp": "./bin/ema-mcp.mjs"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "exports": {
    ".": "./dsh/plugin.mjs",
    "./dsh": "./dsh/plugin.mjs",
    "./mcp": "./src/mcp/tools.mjs",
    "./retrieval": "./src/retrieval/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dsh",
    "skills",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LoveDoLove/Project-Memory-Agent.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible"
      },
      "nodeVersions": ">=18.0.0 <25.0.0",
      "dshVersions": ">=0.1.2-rc.1 <0.2.0-0"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-skill": ">=0.1.2-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}